{
  "name": "finanzblick",
  "private": true,
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test scripts/test-import-batch.mjs scripts/test-i18n.mjs scripts/test-position-history.mjs scripts/test-bank-initials.mjs scripts/test-card-architecture.mjs scripts/test-timeline.mjs scripts/test-appearance.mjs",
    "licenses": "node scripts/collect-licenses.mjs",
    "release": "node scripts/release.mjs",
    "release:mac": "node scripts/release.mjs --bundles dmg",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "tauri icon public/finanzblick.svg --output src-tauri/icons",
    "chat:stage": "node scripts/stage-chat-runtime.mjs",
    "predev": "npm run chat:stage && npm run speech:stage",
    "prebuild": "npm run chat:stage && npm run speech:stage",
    "speech:stage": "node scripts/stage-speech-model.mjs"
  },
  "dependencies": {
    "@lichess-org/vosk-browser": "0.0.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "lightweight-charts": "5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@openai/codex": "0.154.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "overrides": {
    "@lichess-org/vosk-browser": {
      "uuid": "11.1.1"
    }
  }
}
