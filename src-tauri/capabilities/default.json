{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.tradingview.com/"
        }
      ]
    },
    "dialog:default"
  ]
}
